+  /// Copy into 32-bit BGRA with 16-byte-aligned rows — VideoToolbox /
+  /// AVVideoCompositionCoreAnimationTool rejects odd bpp / stride.
+  private static func videoSafeCGImage(from image: UIImage) -> CGImage? {
+    guard let input = image.cgImage else { return nil }
+    let width = max(2, input.width - (input.width % 2))
+    let height = max(2, input.height - (input.height % 2))
+    let bytesPerPixel = 4
+    let bytesPerRow = ((width * bytesPerPixel + 15) / 16) * 16
+    let colorSpace = CGColorSpaceCreateDeviceRGB()
+    let bitmapInfo =
+      CGBitmapInfo.byteOrder32Little.rawValue |
+      CGImageAlphaInfo.premultipliedFirst.rawValue
+    guard let ctx = CGContext(
+      data: nil,
+      width: width,
+      height: height,
+      bitsPerComponent: 8,
+      bytesPerRow: bytesPerRow,
+      space: colorSpace,
+      bitmapInfo: bitmapInfo
+    ) else {
+      return input
+    }
+    ctx.clear(CGRect(x: 0, y: 0, width: width, height: height))
+    ctx.interpolationQuality = .high
+    ctx.draw(input, in: CGRect(x: 0, y: 0, width: width, height: height))
+    return ctx.makeImage() ?? input
+  }
