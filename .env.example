# =============================================================================
# FreshPass Environment Variables
# Copy this file to .env and fill in the values.
# Ask the FreshPass team for actual credentials.
# Switch environments by commenting / uncommenting the active base URL.
# =============================================================================

# -----------------------------------------------------------------------------
# Main API Base URL
# Uncomment ONLY one (dev OR live). Restart Metro after switching.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=https://dev.getfreshpass.com/
# EXPO_PUBLIC_API_BASE_URL=https://getfreshpass.com/

# Guest / unauthenticated API token
EXPO_PUBLIC_AUTH_TOKEN=your-guest-auth-token

# -----------------------------------------------------------------------------
# AI Services (separate host from main API)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_AITOOL_API_BASE_URL=https://ai.getfreshpass.com/
EXPO_PUBLIC_AI_API_BEARER_TOKEN=your-ai-api-bearer-token
EXPO_PUBLIC_WEBHOOK_URL=ws://your-voice-agent-host/api/voice_agent/ws?token=your-ai-api-bearer-token

# -----------------------------------------------------------------------------
# Google Services (Maps, Places, OAuth)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_SEARCH_URL=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=
EXPO_PUBLIC_GOOGLE_FETCH_PLACE_URL=https://maps.googleapis.com/maps/api/place/details/json?fields=formatted_address,address_components,geometry&place_id=

# -----------------------------------------------------------------------------
# Social Login (Facebook & Apple)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
EXPO_PUBLIC_APPLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_APPLE_ANDROID_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Real-time Chat (Laravel Reverb)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_REVERB_APP_KEY=your-reverb-app-key
# Optional overrides (default from API URL hostname / scheme):
# EXPO_PUBLIC_REVERB_WS_HOST=
# EXPO_PUBLIC_REVERB_WS_PORT=
# EXPO_PUBLIC_REVERB_SCHEME=

# -----------------------------------------------------------------------------
# Legal URLs
# -----------------------------------------------------------------------------
EXPO_PUBLIC_TERMS_URL=https://getfreshpass.com/terms-and-conditions
EXPO_PUBLIC_PRIVACY_URL=https://getfreshpass.com/privacy-policy

# =============================================================================
# Firebase Remote Config (NOT in .env — managed in firebase-remote-config-template.json)
# - stripe_publishable_key
# - trial_days
# - default_ai_requests_image
# - default_avatar_image
# - default_business_image
# - default_business_logo
# - default_category_image
# - tutorial_video_tryon_uri
# Deploy: firebase deploy --only remoteconfig
# =============================================================================
